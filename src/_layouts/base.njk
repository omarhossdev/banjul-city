<!DOCTYPE html>
<html lang="en" id="theme-root">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Banjul City Council - {{ title or "The official website of Banjul City Council" }}</title>
  
  <!-- UnoCSS generated styles -->
  <script src="https://cdn.jsdelivr.net/npm/@unocss/runtime"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>
    * {
      padding: 0;
      margin: 0;
      box-sizing: border-box;
    }
    ul li { list-style-type: none!important; }
    [x-cloak] { display: none !important; }
  </style>
</head>
<body x-data="{ open: false, langOpen: false, currentLang: 'EN' }">
  <header class="fixed top-0 w-screen transition duration-100 flex px-1 z-80 py-2 justify-between bg-gray-200/85 dark:bg-gray-950/95
  ">
    <a href="/" class="no-underline flex flex-col items-center">
      <img src="/assets/images/logo.png" class="bg-transparent w-17 sm:w-23" alt="Banjul City Council" />
      <h1 class="text-xs m-0 text-black dark:text-white">Banjul City Council</h1>
    </a>
    <nav class="flex items-center gap-1">
      <button class="border-2 rounded-lg border-gray-900 p-1 dark:border-white bg-transparent text-black dark:text-white" x-data="{
        dark: localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches),
        toggle() {
          this.dark = !this.dark;
          localStorage.setItem('theme', this.dark ? 'dark' : 'light');
          document.documentElement.classList.toggle('dark', this.dark);
        }
      }"
      x-init="document.documentElement.classList.toggle('dark', dark)"
      @click="toggle()"
      :aria-label="dark ? 'Switch to light theme' : 'Switch to dark theme'">
        <svg x-show="dark" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
        </svg>


        <svg x-show="!dark" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
        </svg>
      </button>

      <button id="menu-btn" aria-label="Toggle Navigation" class="border-2 rounded-lg border-gray-950 dark:border-white bg-transparent text-black dark:text-white p-1" @click="open = !open" :aria-expanded="open">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </nav>
  </header>

  <aside class="z-80 fixed top-0 left-0 pt-11 w-screen min-h-screen overflow-y-auto bg-gray-300/72 dark:bg-gray-900/95 gap-6 px-2 pb-2 md:p-0" x-show="open" x-transition>
    <button class="border-0 absolute top-5 right-4 p-0 text-black dark:text-white bg-transparent" @click="open = false">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-9">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>

    <ul class="text-center flex flex-col md:flex-row gap-2 md:gap-6 mb-4 md:mb-0">
      <li><a href="/" class="block py-1.5 px-3 rounded-lg text-lg font-medium text-slate-700 dark:text-slate-200">Home</a></li>
      <li><a href="/services" class="block py-1.5 px-3 rounded-lg text-lg font-medium text-slate-700 dark:text-slate-200">Online Services</a></li>
      <li><a href="/news" class="block py-1.5 px-3 rounded-lg text-lg font-medium text-slate-700 dark:text-slate-200">Latest News</a></li>
      <li><a href="/projects" class="block py-1.5 px-3 rounded-lg text-lg font-medium text-slate-700 dark:text-slate-200">Our Projects</a></li>
      <li><a href="/vision" class="block py-1.5 px-3 rounded-lg text-lg font-medium text-slate-700 dark:text-slate-200">Vision & Mission</a></li>
      <li><a href="/contact" class="block py-1.5 px-3 rounded-lg text-lg font-medium text-slate-700 dark:text-slate-200">Contact</a></li>
    </ul>

    <!-- Search Input Container -->
    <form class="relative w-full md:w-64" role="search" onsubmit="event.preventDefault()">
      <div class="relative flex items-center">
        <svg class="absolute left-3 w-4 h-4 stroke-slate-400 dark:stroke-slate-400 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
        </svg>
        <input 
          type="search" 
          placeholder="Search..." 
          aria-label="Search site"
          class="w-full pl-9 pr-3 py-1.5 text-md text-slate-900 bg-slate-200 dark:bg-slate-900 dark:text-slate-100 placeholder-slate-500 dark:placeholder-slate-400 rounded-lg"
        />
      </div>
    </form>

    <div class="relative mt-2" @click.outside="langOpen = false">
      <button 
        @click="langOpen = !langOpen" 
        :aria-expanded="langOpen"
        aria-haspopup="true"
        aria-label="Select Language"
        class="px-3 py-1.5 bg-slate-200 text-black dark:bg-blue-950 dark:text-white rounded w-full flex items-center justify-center gap-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
          </svg>
        <span x-text="currentLang">EN </span>
        <svg class="w-3 h-3 transition-transform" :class="langOpen ? 'rotate-180' : ''" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </button>

      <!-- Dropdown Menu -->
      <div 
        x-show="langOpen" 
        x-transition.opacity.duration.150ms
        class="grid grid-cols-3 w-full bg-slate-900 border-2 rounded-lg"
      >
        <button @click="currentLang = 'EN'; langOpen = false" class="w-full px-3 py-1.5 text-xs bg-slate-100 text-black dark:bg-blue-800 dark:text-white ">English</button>
        <button @click="currentLang = 'AR'; langOpen = false" class="w-full px-3 py-1.5 text-xs bg-slate-100 text-black dark:bg-blue-800 dark:text-white">Arabic</button>
        <button @click="currentLang = 'FR'; langOpen = false" class="w-full px-3 py-1.5 text-xs bg-slate-100 text-black dark:bg-blue-800 dark:text-white">French</button>
        <button @click="currentLang = 'CH'; langOpen = false" class="w-full px-3 py-1.5 text-xs bg-slate-100 text-black dark:bg-blue-800 dark:text-white">Chinese</button>
        <button @click="currentLang = 'GE'; langOpen = false" class="w-full px-3 py-1.5 text-xs bg-slate-100 text-black dark:bg-blue-800 dark:text-white">German</button>
        <button @click="currentLang = 'IT'; langOpen = false" class="w-full px-3 py-1.5 text-xs bg-slate-100 text-black dark:bg-blue-800 dark:text-white">Italian</button>
      </div>
    </div>
  </aside>

  <main class="bg-gray-100 text-gray-900 min-h-screen flex flex-col font-sans">
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}
</body>
</html>